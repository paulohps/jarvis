    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarvis listens to your voice commands when you tap the microphone, and records the voice notes you schedule on WhatsApp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jarvis ouve os seus comandos de voz quando você toca no microfone e grava as mensagens de voz que você agenda no WhatsApp."
          }
        }
      }
