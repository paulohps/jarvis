        }
      }
    },
    "Turn on Full Access in Settings › General › Keyboard › Keyboards › Jarvis so the keyboard can reach Jarvis.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Acesso Total em Ajustes › Geral › Teclado › Teclados › Jarvis para o teclado falar com o Jarvis."
